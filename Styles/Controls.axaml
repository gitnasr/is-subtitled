<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and text defaults -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- 11px uppercase section headers, per DESIGN.md -->
    <Style Selector="TextBlock.label-caps">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="0.55"/>
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Paths, counts, anything technical -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Cards: level 1 surface plus hairline -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainerHover}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnPrimary}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnSurface}"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource ErrorDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource Error}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorContainer}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorContainer}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnErrorContainer}"/>
    </Style>

    <!-- Borderless icon button used inside data rows -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHighest}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Primary}"/>
    </Style>

    <!-- A filename or folder name that behaves as a link -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Primary}"/>
    </Style>

    <!-- Inputs: darker than their surface, border goes primary on focus -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <!-- Fluent's default accent for the selected item is a red that reads as an error here -->
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnPrimary}"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnSurface}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainerHover}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnPrimary}"/>
    </Style>

    <!-- Chips: pill shaped so they never read as buttons -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style Selector="Border.chip-static">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Padding" Value="9,2"/>
    </Style>

    <!-- Count badge on a folder group header -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="MinWidth" Value="26"/>
    </Style>

    <!-- Data rows: 32px, transparent until hovered, actions fade in on hover -->
    <Style Selector="Border.row">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
    </Style>
    <Style Selector="Border.row StackPanel#RowActions">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.row:pointerover StackPanel#RowActions">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Group header strip -->
    <Style Selector="Border.group-header">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Border.group-header:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
    </Style>
</Styles>
