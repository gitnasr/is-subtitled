<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IsSubtitled.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="IsSubtitled.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Width="900" Height="700"
        MinWidth="640" MinHeight="480"
        Icon="/Assets/avalonia-logo.ico"
        Title="Is Subtitled">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel Margin="20">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Text="Is Subtitled" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Find video files missing a matching subtitle." Opacity="0.7"/>
        </StackPanel>

        <!-- Controls card -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16" Padding="16"
                Background="#1f2937" CornerRadius="8" BorderBrush="#374151" BorderThickness="1">
            <StackPanel Spacing="12">
                <!-- Folder -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Folder to scan" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Choose folder…" Command="{Binding PickFolderCommand}"/>
                        <TextBlock Text="{Binding SelectedFolder, FallbackValue='No folder selected'}"
                                   VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Excluded folder names -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Excluded folder names" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="320" PlaceholderText="Folder name to skip (Enter to add)"
                                 Text="{Binding NewExcluded}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddExcludedCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="Add" Command="{Binding AddExcludedCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ExcludedDirs}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="#374151" CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        <Button Content="✕" Padding="2,0" FontSize="11"
                                                Background="Transparent" BorderThickness="0"
                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveExcludedCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Scan" Command="{Binding ScanCommand}"
                            IsVisible="{Binding IsIdle}"
                            Background="#16a34a" Foreground="White"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsScanning}"
                            Background="#dc2626" Foreground="White"/>
                    <Button Content="Save results…" Command="{Binding SaveCommand}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Padding="8" Background="#1f2937" CornerRadius="8"
                BorderBrush="#374151" BorderThickness="1">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DirectoryGroup">
                            <Border Background="#111827" CornerRadius="6" Padding="12" Margin="4"
                                    BorderBrush="#374151" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="{Binding Directory}" FontWeight="Bold"
                                                HorizontalAlignment="Left" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Open folder in file manager"
                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).OpenFolderCommand}"
                                                CommandParameter="{Binding Directory}"/>
                                        <Button Content="📋" Padding="2,0" FontSize="11"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Copy folder path"
                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CopyPathCommand}"
                                                CommandParameter="{Binding Directory}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Videos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoItem">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,1,0,1">
                                                    <Button Content="{Binding Name}"
                                                            HorizontalAlignment="Left" Padding="2,0"
                                                            Background="Transparent" BorderThickness="0"
                                                            ToolTip.Tip="Open in file manager"
                                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="📋" Padding="2,0" FontSize="11"
                                                            Background="Transparent" BorderThickness="0"
                                                            ToolTip.Tip="Copy full path"
                                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CopyPathCommand}"
                                                            CommandParameter="{Binding FullPath}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
